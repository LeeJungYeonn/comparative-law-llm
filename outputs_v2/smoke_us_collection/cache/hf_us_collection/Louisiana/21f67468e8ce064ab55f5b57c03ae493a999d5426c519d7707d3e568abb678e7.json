    {
      "row_idx": 4605,
      "row": {
        "id": 1587371,
        "judges": "Johnson, Weimer",
        "date_filed": "2010-02-06",
        "date_filed_is_approximate": false,
        "slug": "state-v-anderson",
        "case_name_short": "Anderson",
        "case_name": "State v. Anderson",
        "case_name_full": "STATE of Louisiana, v. Michael ANDERSON",
        "attorneys": null,
        "nature_of_suit": null,
        "posture": null,
        "syllabus": null,
        "headnotes": null,
        "summary": null,
        "disposition": null,
        "history": null,
        "other_dates": null,
        "cross_reference": null,
        "correction": null,
        "citation_count": 0,
        "precedential_status": "Published",
        "arguments": null,
        "headmatter": "<parties id=\"b930-9\">\n    STATE of Louisiana, v. Michael ANDERSON.\n   </parties><docketnumber id=\"Agnh\">\n    No. 2010-KK-292.\n   </docketnumber><br><court id=\"b930-12\">\n    Supreme Court of Louisiana.\n   </court><br><decisiondate id=\"b930-13\">\n    Feb. 6, 2010.\n   </decisiondate>",
        "citations": [
          "33 So. 3d 882"
        ],
        "opinions": [
          {
            "author_str": null,
            "per_curiam": false,
            "type": "020lead",
            "page_count": null,
            "download_url": null,
            "author_id": null,
            "opinion_text": "\nIn re Anderson, Michael; — defendant; Applying for Supervisory and/or Remedial Writs, Parish of Orleans, Criminal District Court Div. B, No. 472-217; to the Court of Appeal, Fourth Circuit, No. 2010-K-0170.\nStay denied; writ denied.\nJOHNSON, J., would grant the stay and writ, and assigns reasons.\n",
            "ocr": false,
            "opinion_id": 9656625
          },
          {
            "author_str": "Weimer",
            "per_curiam": false,
            "type": "030concurrence",
            "page_count": null,
            "download_url": null,
            "author_id": null,
            "opinion_text": "\nWEIMER, J.,\nconcurs in part and dissents in part. I concur in the denial of the requested stay, but dissent from the denial of the defendant’s writ application. I would grant that application and order the trial court to conduct an in camera inspection to determine if there is additional undisclosed Brady material in the District Attorney’s file.\nJOHNSON, J. would grant the writ application for the following reasons.\nGiven the serious nature of both the alleged misconduct of the State and the gravity of the sentence imposed, I would grant the defendant’s writ application, and order the trial court to conduct an in camera inspection of the District Attorney’s file to determine whether it contains additional undisclosed Brady1 material.\nClearly, there is no “work product” exception for Brady material in either federal or state law. The accused has a constitutional right to exculpatory material that supersedes state legislative statutory privilege. Considering the recently disclosed evidence of the sole eyewitness’ visual impairments, I would grant a stay to allow the defendant his right to compulsory process in order to develop his claims in support of his motion for New Trial. Where a “witness may labor under a deficiency,” the defense should be afforded some latitude” in exploring the deficiency in order to satisfy the Sixth Amendment.2\n\n. Brady v. Maryland, 373 U.S. 83, 83 S.Ct. 1194, 10 L.Ed.2d 215 (1963).\n\n\n. State v. Robinson, 817 So.2d 1131, 1137 (La.2002).\n\n",
            "ocr": false,
            "opinion_id": 9656626
          },
          {
            "author_str": null,
            "per_curiam": false,
            "type": "010combined",
            "page_count": null,
            "download_url": null,
            "author_id": 4583,
            "opinion_text": "\n33 So.3d 882 (2010)\nSTATE of Louisiana,\nv.\nMichael ANDERSON.\nNo. 2010-KK-292.\nSupreme Court of Louisiana.\nFebruary 6, 2010.\nStay denied; writ denied.\nJOHNSON, J., would grant the stay and writ, and assigns reasons.\nWEIMER, J., concurs in part and dissents in part.\nI concur in the denial of the requested stay, but dissent from the denial of the defendant's writ application. I would grant that application and order the trial court to conduct an in camera inspection to determine if there is additional undisclosed Brady material in the District Attorney's file.\nJOHNSON, J. would grant the writ application for the following reasons.\nGiven the serious nature of both the alleged misconduct of the State and the gravity of the sentence imposed, I would grant the defendant's writ application, and order the trial court to conduct an in camera inspection of the District Attorney's file to determine whether it contains additional undisclosed Brady[1] material.\nClearly, there is no \"work product\" exception for Brady material in either federal or state law. The accused has a constitutional right to exculpatory material that supersedes state legislative statutory privilege. Considering the recently disclosed evidence of the sole eyewitness' visual impairments, I would grant a stay to allow the defendant his right to compulsory process in order to develop his claims in support of his motion for New Trial. Where a \"witness may labor under a deficiency,\" the defense should be afforded some latitude\" in exploring the deficiency in order to satisfy the Sixth Amendment.[2]\nNOTES\n[1]  Brady v. Maryland, 373 U.S. 83, 83 S.Ct. 1194, 10 L.Ed.2d 215 (1963).\n[2]  State v. Robinson, 817 So.2d 1131, 1137 (La.2002).\n\n",
            "ocr": false,
            "opinion_id": 1587371
          }
        ],
        "court_short_name": "Supreme Court of Louisiana",
        "court_full_name": "Supreme Court of Louisiana",
        "court_type": "S",
        "court_jurisdiction": "Louisiana, LA"
      },
      "truncated_cells": []
